{% liquid
  assign s = block.settings
  assign block_index = section.blocks | find_index: 'id', block.id
  assign use_video = false
  if s.media_type == 'video' and s.video != blank
    assign use_video = true
  endif

  assign overlay_class = ''
  case s.overlay_style
    when 'solid'
      assign overlay_class = ''
    when 'gradient_bottom'
      assign overlay_class = ' bandev-hero-slide__overlay--gradient-bottom'
    when 'gradient_top'
      assign overlay_class = ' bandev-hero-slide__overlay--gradient-top'
    when 'gradient_radial'
      assign overlay_class = ' bandev-hero-slide__overlay--gradient-radial'
  endcase

  assign vertical_class = 'bandev-hero-slide__content--' | append: s.vertical_position
  assign horizontal_class = 'bandev-hero-slide__content--' | append: s.horizontal_position
  assign align_class = 'bandev-hero-slide__inner--align-' | append: s.text_align

  assign loading = 'lazy'
  assign fetchpriority = 'low'
  if block_index == 0 and section.index <= 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  endif

  assign overlay_color = s.overlay_color | default: '#000000'
  assign overlay_opacity = s.overlay_opacity | default: 35
  assign overlay_alpha = overlay_opacity | divided_by: 100.0
  assign overlay_rgba = overlay_color | color_modify: 'alpha', overlay_alpha
%}

<div
  class="bandev-hero__slide-item color-{{ s.color_scheme }}"
  aria-hidden="{% if block_index == 0 %}false{% else %}true{% endif %}"
  data-index="{{ block_index }}"
  {{ block.shopify_attributes }}
>
  <article class="bandev-hero-slide" style="--bandev-overlay-color: {{ overlay_rgba }};">
    <div class="bandev-hero-slide__media{% if s.image == blank and use_video == false %} bandev-hero-slide__media--placeholder{% endif %}">
      {%- if use_video -%}
        {%- if s.video.preview_image -%}
          {{
            s.video.preview_image
            | image_url: width: 3200
            | image_tag:
              widths: '480, 768, 1024, 1440, 1920, 2560, 3200',
              sizes: '100vw',
              loading: loading,
              fetchpriority: fetchpriority,
              alt: s.heading
          }}
        {%- endif -%}
        {{
          s.video
          | video_tag:
            poster: nil,
            autoplay: true,
            loop: true,
            controls: false,
            muted: true
        }}
      {%- elsif s.image != blank -%}
        {{
          s.image
          | image_url: width: 3200
          | image_tag:
            widths: '480, 768, 1024, 1440, 1920, 2560, 3200',
            sizes: '100vw',
            loading: loading,
            fetchpriority: fetchpriority,
            alt: s.image.alt | default: s.heading
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>

    {%- if s.show_overlay -%}
      <div class="bandev-hero-slide__overlay{{ overlay_class }}"></div>
    {%- endif -%}

    <div class="bandev-hero-slide__content {{ vertical_class }} {{ horizontal_class }}">
      <div class="bandev-hero-slide__inner {{ align_class }}">
        {%- if s.eyebrow != blank -%}
          <p class="bandev-hero-slide__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <{{ s.heading_tag }} class="bandev-hero-slide__heading">{{ s.heading | escape }}</{{ s.heading_tag }}>
        {%- endif -%}

        {%- if s.subheading != blank -%}
          <div class="bandev-hero-slide__subheading rte">{{ s.subheading }}</div>
        {%- endif -%}

        {%- if s.button_1_label != blank or s.button_2_label != blank -%}
          <div class="bandev-hero-slide__actions">
            {%- if s.button_1_label != blank -%}
              <a
                href="{{ s.button_1_link | default: '#' }}"
                class="bandev-hero-slide__btn bandev-hero-slide__btn--{{ s.button_1_style }}"
              >
                {{ s.button_1_label | escape }}
              </a>
            {%- endif -%}
            {%- if s.button_2_label != blank -%}
              <a
                href="{{ s.button_2_link | default: '#' }}"
                class="bandev-hero-slide__btn bandev-hero-slide__btn--{{ s.button_2_style }}"
              >
                {{ s.button_2_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </article>
</div>

{% schema %}
{
  "name": "Bandev hero slide",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "visible_if": "{{ block.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "visible_if": "{{ block.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show overlay",
      "default": true
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "Overlay style",
      "options": [
        { "value": "solid", "label": "Solid" },
        { "value": "gradient_bottom", "label": "Gradient (from bottom)" },
        { "value": "gradient_top", "label": "Gradient (from top)" },
        { "value": "gradient_radial", "label": "Radial vignette" }
      ],
      "default": "gradient_bottom",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000",
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 35,
      "visible_if": "{{ block.settings.show_overlay }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sit back. Relax. Enjoy."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Discover the comfort that redefines the way you live.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "vertical_position",
      "label": "Vertical position",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "middle"
    },
    {
      "type": "select",
      "id": "horizontal_position",
      "label": "Horizontal position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Slide color scheme",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Button 1 label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "button_1_style",
      "label": "Button 1 style",
      "options": [
        { "value": "primary", "label": "Primary (filled)" },
        { "value": "secondary", "label": "Secondary (outline)" },
        { "value": "accent", "label": "Accent (gold)" }
      ],
      "default": "primary"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Button 2 style",
      "options": [
        { "value": "primary", "label": "Primary (filled)" },
        { "value": "secondary", "label": "Secondary (outline)" },
        { "value": "accent", "label": "Accent (gold)" }
      ],
      "default": "secondary"
    }
  ]
}
{% endschema %}
