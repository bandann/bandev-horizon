{% liquid
  assign s = section.settings
  assign block_count = section.blocks.size

  assign pin_blocks = section.blocks | where: 'type', 'bandev-shop-pin'
  assign sidebar_blocks_size = block_count | minus: pin_blocks.size

  assign layout_class = 'bandev-shop bandev-shop--layout-' | append: s.layout
  assign header_class = 'bandev-shop__header bandev-shop__header--' | append: s.header_alignment
  assign media_class = 'bandev-shop__media bandev-shop__media--ratio-' | append: s.image_ratio | replace: '/', '-'
%}

{{ 'bandev-shop-the-look.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'bandev-shop-the-look.js' | asset_url }}" defer="defer"></script>

<div class="section-background color-{{ s.color_scheme }}"></div>
<div
  class="bandev-shop-section section spacing-style section--{{ s.section_width }} color-{{ s.color_scheme }}"
  style="{% render 'spacing-padding', settings: s %}"
>
  <bandev-shop-the-look class="{{ layout_class }}">
    {%- if s.eyebrow != blank or s.title != blank or s.description != blank -%}
      <div class="{{ header_class }}">
        {%- if s.eyebrow != blank -%}
          <p class="bandev-shop__eyebrow">{{ s.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if s.title != blank -%}
          <{{ s.heading_tag }} class="bandev-shop__title">{{ s.title | escape }}</{{ s.heading_tag }}>
        {%- endif -%}
        {%- if s.description != blank -%}
          <p class="bandev-shop__description">{{ s.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bandev-shop__container">
      <div class="bandev-shop__media-wrapper">
        <div class="{{ media_class }}">
          {%- if s.image != blank -%}
            {{
              s.image
              | image_url: width: 2000
              | image_tag:
                widths: '480, 768, 1024, 1440, 1920, 2000',
                sizes: '(min-width: 1024px) 70vw, 100vw',
                loading: 'lazy',
                alt: s.image.alt | default: s.title
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}

          {# Render only pin blocks overlaid on the image #}
          {%- for block in section.blocks -%}
            {%- if block.type == 'bandev-shop-pin' -%}
              {% render block %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if pin_blocks.size > 0 or sidebar_blocks_size > 0 -%}
        <div class="bandev-shop__products">
          {# 1) Pin-derived product cards #}
          {%- for block in pin_blocks -%}
            {%- assign p = block.settings.product -%}
            {%- assign idx = forloop.index -%}
            {%- if p != blank -%}
              <a
                href="{{ p.url }}"
                class="bandev-shop__product"
                data-product-card
                data-product-id="{{ block.id }}"
              >
                {%- if s.show_numbers -%}
                  <span class="bandev-shop__product-number" aria-hidden="true">{{ idx }}</span>
                {%- endif -%}
                <div class="bandev-shop__product-image">
                  {%- if p.featured_image -%}
                    {{
                      p.featured_image
                      | image_url: width: 200
                      | image_tag:
                        widths: '120, 200',
                        sizes: '56px',
                        loading: 'lazy',
                        alt: p.title
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="bandev-shop__product-info">
                  <p class="bandev-shop__product-title">{{ p.title }}</p>
                  <p class="bandev-shop__product-price">{{ p.price | money }}</p>
                </div>
                {%- if s.show_cta -%}
                  <span class="bandev-shop__product-cta">{{ s.cta_label | default: 'Shop' }}</span>
                {%- endif -%}
              </a>
            {%- else -%}
              <div class="bandev-shop__product" data-product-card data-product-id="{{ block.id }}">
                {%- if s.show_numbers -%}
                  <span class="bandev-shop__product-number" aria-hidden="true">{{ idx }}</span>
                {%- endif -%}
                <div class="bandev-shop__product-image">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
                <div class="bandev-shop__product-info">
                  <p class="bandev-shop__product-title">{{ block.settings.fallback_label | default: 'Pick a product' }}</p>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {# 2) Free-form blocks (product cards, text, button, image) #}
          {%- if sidebar_blocks_size > 0 -%}
            <div class="bandev-shop__extra-blocks">
              {%- for block in section.blocks -%}
                {%- unless block.type == 'bandev-shop-pin' -%}
                  <div class="bandev-shop__extra-block bandev-shop__extra-block--{{ block.type }}" {{ block.shopify_attributes }}>
                    {% render block %}
                  </div>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </bandev-shop-the-look>
</div>

{% schema %}
{
  "name": "Bandev shop the look",
  "class": "bandev-shop-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "max_blocks": 24,
  "settings": [
    {
      "type": "header",
      "content": "t:content.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        { "value": "16/9",  "label": "16:9" },
        { "value": "21/9",  "label": "21:9" },
        { "value": "4/3",   "label": "t:options.landscape" },
        { "value": "1/1",   "label": "t:options.square" },
        { "value": "3/4",   "label": "t:options.portrait" }
      ],
      "default": "4/3"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop the look"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Get inspired"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:settings.title",
      "options": [
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:names.description",
      "default": "<p>Click on each pin to discover the products featured in this look.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "left",   "label": "t:options.left" },
        { "value": "center", "label": "t:options.center" },
        { "value": "right",  "label": "t:options.right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.alignment",
      "options": [
        { "value": "right",  "label": "t:options.right" },
        { "value": "left",   "label": "t:options.left" },
        { "value": "bottom", "label": "t:options.bottom" }
      ],
      "default": "right"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:settings.products"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Show pin numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show shop label",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:settings.label",
      "default": "Shop",
      "visible_if": "{{ section.settings.show_cta == true }}"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Bandev shop the look",
      "category": "t:categories.products",
      "settings": {
        "image_ratio": "4/3",
        "eyebrow": "Shop the look",
        "title": "Get inspired",
        "heading_tag": "h2",
        "header_alignment": "center",
        "section_width": "page-width",
        "layout": "right",
        "color_scheme": "scheme-1",
        "show_numbers": true,
        "show_cta": true
      },
      "blocks": {
        "pin_1": { "type": "bandev-shop-pin" },
        "pin_2": { "type": "bandev-shop-pin" },
        "pin_3": { "type": "bandev-shop-pin" }
      },
      "block_order": ["pin_1", "pin_2", "pin_3"]
    }
  ]
}
{% endschema %}
